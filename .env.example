# Copy to .env and fill in real values: cp .env.example .env
# Never commit .env.

# --- Postgres (used by docker compose) --------------------------------------
POSTGRES_USER=briefbase
POSTGRES_PASSWORD=briefbase2026
POSTGRES_DB=briefbasedb

# --- Backend ----------------------------------------------------------------
# Host "db" is the docker compose service name. When running the backend
# outside Docker, use localhost instead.
DATABASE_URL=postgresql+psycopg://briefbase:briefbase2026@db:5432/briefbasedb

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
